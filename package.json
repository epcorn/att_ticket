{
  "name": "Att_ticket",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "npx nodemon server.js",
    "build": "npm run setup-production",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npx nodemon server.js\" \"npm run client\"",
    "setup-production": "npm run install-client && npm run build-client",
    "install-client": "cd client && npm install",
    "build-client": "cd client && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@getbrevo/brevo": "^6.0.3",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "concurrently": "^10.0.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-fileupload": "^1.5.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.4",
    "morgan": "^1.12.0"
  },
  "nodemonConfig": {
    "ignore": [
      "client/*"
    ]
  }
}
